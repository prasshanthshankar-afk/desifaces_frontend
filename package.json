{
  "name": "desifaces-mobile",
  "main": "expo-router/entry",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "start:web": "expo start -c --web",
    "dev:reset": "./scripts/dev-reset.sh",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"app.config.ts\" --no-error-on-unmatched-pattern",
    "certify:v3-story": "eslint 'src/app/(tabs)/face/multi-person.tsx' 'src/app/(tabs)/face/story/[storyId].tsx' src/core/studio/DenseStudioUI.tsx src/core/studio/productionExperience.ts src/core/studio/multiPersonWorkflow.ts src/features/face/FaceCreationModeSwitch.tsx src/features/face/MultiPersonFaceDirectorScreen.tsx src/features/face/MultiPersonFaceSavedWorkScreen.tsx src/features/face/MultiPersonFaceCohortDenseScreen.tsx src/features/audio/MultiPersonAudioWorkspaceScreen.tsx src/features/audio/api/multiPersonStory.ts src/features/audio/api/masterdataAudio.ts src/features/fusion/MultiPersonFusionDenseScreen.tsx src/features/fusion/api/multiPersonStory.ts --max-warnings=0 && tsc --noEmit --pretty false",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@tamagui/config": "^1.135.4",
    "@tamagui/font-inter": "^1.135.4",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "file:./vendor/expo-glass-effect",
    "expo-haptics": "~55.0.16",
    "expo-iap": "^4.2.3",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.10",
    "expo-video": "~2.2.2",
    "expo-web-browser": "~14.2.0",
    "i18next": "^25.8.0",
    "js-tokens": "^10.0.0",
    "lottie-react": "^2.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@tamagui/babel-plugin": "^1.135.4",
    "@types/node": "^22.15.21",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~13.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    },
    "install": {
      "exclude": [
        "expo-glass-effect"
      ]
    }
  },
  "overrides": {
    "expo-glass-effect": "file:./vendor/expo-glass-effect"
  }
}