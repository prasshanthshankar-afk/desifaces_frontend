{
  "cli": {
    "version": ">= 18.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.desifaces.ai",
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://api.desifaces.ai",
        "EXPO_PUBLIC_CORE_BASE_URL": "https://api.desifaces.ai/core",
        "EXPO_PUBLIC_FACE_BASE_URL": "https://api.desifaces.ai/face",
        "EXPO_PUBLIC_AUDIO_BASE_URL": "https://api.desifaces.ai/audio",
        "EXPO_PUBLIC_VIDEO_BASE_URL": "https://api.desifaces.ai/video",
        "EXPO_PUBLIC_FUSION_BASE_URL": "https://api.desifaces.ai/video",
        "EXPO_PUBLIC_DASHBOARD_BASE_URL": "https://api.desifaces.ai/dashboard",
        "EXPO_PUBLIC_PRICING_BASE_URL": "https://api.desifaces.ai/pricing",
        "EXPO_PUBLIC_DIRECTOR_BASE_URL": "https://api.desifaces.ai/director",
        "EXPO_PUBLIC_ASSISTANT_BASE_URL": "https://api.desifaces.ai/assistant",
        "EXPO_PUBLIC_FUSION_EXTENSION_BASE_URL": "https://api.desifaces.ai/fusion-extension",
        "EXPO_PUBLIC_BILLING_RETURN_URL_BASE": "https://app.desifaces.ai/pricing/plan-billing"
      }
    },
    "development-testflight": {
      "autoIncrement": true,
      "environment": "development",
      "distribution": "store",
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "prashanth@desifaces.ai",
        "appleTeamId": "9GZ97FB9SW",
        "ascAppId": "6770987492"
      }
    },
    "development-testflight": {}
  }
}
