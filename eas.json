{
  "cli": {
    "version": ">= 18.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "distribution": "store"
      }
    },
    "development-testflight": {
      "autoIncrement": true,
      "environment": "development",
      "distribution": "store",
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "prashanth@desifaces.ai",
        "appleTeamId": "9GZ97FB9SW"
      }
    },
    "development-testflight": {}
  }
}
