{
  "cli": {
    "version": ">= 18.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "distribution": "store"
      }
    },
    "android-inr-qa": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_PRICING_BASE_URL": "https://api.desifaces.ai/pricing",
        "EXPO_PUBLIC_DF_FORCE_COUNTRY_CODE": "IN",
        "EXPO_PUBLIC_DF_FORCE_CURRENCY": "INR",
        "EXPO_PUBLIC_DF_FORCE_LOCALE": "en-IN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
